# =============================================================================
# SPARTANS GYM MANAGEMENT SYSTEM - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# MongoDB connection string
# Local: mongodb://localhost:27017
# Docker: mongodb://mongodb:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=spartans_gym

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# JWT secret key (generate a strong random string for production)
# Example: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# JWT token expiry in days
JWT_EXPIRY_DAYS=7

# -----------------------------------------------------------------------------
# COOKIE CONFIGURATION
# -----------------------------------------------------------------------------
# Environment name: local | production
# In production, cookies are always forced to Secure=true in code.
ENVIRONMENT=local

# Set to false for local HTTP development (no HTTPS).
# When false, cookies use SameSite=Lax which works over plain HTTP.
# For production with HTTPS, set to true (uses SameSite=None; Secure).
COOKIE_SECURE=false

# SameSite policy: lax (default for local), none (requires COOKIE_SECURE=true)
# Leave empty to auto-detect based on COOKIE_SECURE
COOKIE_SAMESITE=

# -----------------------------------------------------------------------------
# PRODUCTION (REFERENCE)
# -----------------------------------------------------------------------------
# ENVIRONMENT=production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Do not use "*" when using credentials/cookies; use explicit origins instead.
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:3000,http://127.0.0.1:3000

# Production example:
# CORS_ORIGINS=https://spartans.mc1services.com,https://spartansapi.mc1services.com

# -----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------
# Directory for file uploads (absolute or relative to backend folder)
UPLOAD_DIR=./uploads

# Maximum upload file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (OPTIONAL)
# -----------------------------------------------------------------------------
# Set to true to enable Google OAuth login
GOOGLE_OAUTH_ENABLED=false

# OAuth session verification URL (required if GOOGLE_OAUTH_ENABLED=true)
# This is the URL of your OAuth session provider
GOOGLE_OAUTH_SESSION_URL=

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Server host and port (used by uvicorn)
HOST=0.0.0.0
PORT=8000
