# =============================================================================
# SPARTANS GYM MANAGEMENT SYSTEM - Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Backend API URL (do NOT include trailing slash or /api)
# Local development: http://localhost:8000
# Production: https://your-api-domain.com
REACT_APP_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (OPTIONAL)
# -----------------------------------------------------------------------------
# Set to true to show Google OAuth login button
REACT_APP_GOOGLE_OAUTH_ENABLED=false

# Google OAuth provider URL (required if REACT_APP_GOOGLE_OAUTH_ENABLED=true)
REACT_APP_GOOGLE_OAUTH_URL=

# Google OAuth Client ID (only needed for custom OAuth)
REACT_APP_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable/disable features
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_I18N=true

# Default language (en, ar)
REACT_APP_DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS
# -----------------------------------------------------------------------------
# Skip preflight check (useful for some setups)
SKIP_PREFLIGHT_CHECK=true
PORT=3010
